PORT=3000

# Personal ABA Bank Account Settings (Individual KHQR - No Merchant Account Needed)
BAKONG_ACCOUNT_ID=abaakhppxxx@abaa
ABA_ACCOUNT_NUMBER=000000000
BAKONG_ACQUIRING_BANK=ABA Bank
