PORT=3000
# Personal ABA / Bakong Account Settings (Individual KHQR - No Merchant Needed)
# Note: In the Bakong app or ABA KHQR, your Bakong Account ID looks like: your_name@aba or your_name@bkrt
BAKONG_ACCOUNT_ID=chan_panha@aba
BAKONG_ACCOUNT_NAME=CHAN PANHA
BAKONG_MERCHANT_CITY=Phnom Penh
# Optional: NBC Bakong Developer Token from https://api-bakong.nbc.gov.kh
# Leave blank to use Mock/Manual Verification mode while still generating REAL scannable KHQR codes!
BAKONG_DEV_TOKEN=
# Set to true to allow 100 KHR (~$0.03) test QR codes during live class demo
DEMO_TEST_AMOUNT_KHR=100
